{% set pageTitle = title + " — 吴宜凡 Yifan (Margaret) Wu" %}
{% set ogTitle = title %}
{% set ogDescription = summary %}
{% set ogImage = cover %}
{% set c = cats[category] %}
{% set twin = collections.articlesEn | findTwin(page.fileSlug) %}
<!doctype html>
<html lang="zh-CN">
<head>
{% include "head.njk" %}
<style>
.body p{margin:0 0 24px}
.body h2{margin:48px 0 16px;font-family:'Noto Sans SC',sans-serif;font-size:30px;font-weight:900;line-height:1.35}
.body h3{margin:36px 0 12px;font-family:'Noto Sans SC',sans-serif;font-size:22px;font-weight:900;line-height:1.4}
.body ul,.body ol{margin:0 0 24px;padding-left:22px}
.body li{margin:0 0 8px}
.body blockquote{margin:40px 0;padding:8px 0 8px 24px;border-left:6px solid #FF8A65;font-family:'Noto Sans SC',sans-serif;font-size:24px;font-weight:900;line-height:1.5}
.body blockquote p{margin:0}
.body img{width:100%;height:auto;border-radius:20px;border:2px solid #0F1020;margin:32px 0}
.body a{text-decoration:underline}
.body hr{border:0;border-top:2px solid #0F1020;margin:40px 0}
.body table{width:100%;border-collapse:collapse;margin:0 0 24px;font-size:16px}
.body th,.body td{border:2px solid #0F1020;padding:10px 12px;text-align:left}
</style>
</head>
<body>
<div style="background: #FFFBF2; color: #0F1020; font-family: Inter, 'Noto Sans SC', system-ui, sans-serif; font-size: 18px; line-height: 1.85">

{% include "header-zh.njk" %}

<section style="max-width: 820px; margin: 0 auto; padding: 56px 32px 72px">
<div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 24px">
<span style="padding: 5px 12px; border-radius: 999px; border: 1.5px solid #0F1020; font-size: 13px; font-weight: 700; background: {{ c.color }}; color: #0F1020">{{ c.zh }}</span>
{% if her_game %}<span style="padding: 5px 12px; border-radius: 999px; border: 1.5px solid #0F1020; font-size: 13px; font-weight: 700; background: #E2B6FF; color: #0F1020">★ Her Game</span>{% endif %}
{% if twin %}<a href="{{ twin.url }}" style="padding: 5px 12px; border-radius: 999px; border: 1.5px solid #0F1020; font-size: 13px; font-weight: 700; background: #FFFFFF; color: #0F1020; text-decoration: none">English</a>{% endif %}
<span style="font-size: 14px; font-weight: 600; color: #D5D7E2">{{ date | fmtDate("zh") }}</span>
</div>
<h1 style="margin: 0 0 24px; font-family: 'Noto Sans SC', sans-serif; font-weight: 900; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.5">{{ title }}</h1>
<p style="margin: 0; font-size: 20px; line-height: 1.7; color: #D5D7E2">{{ summary }}</p>
</section>
</div>

<div style="max-width: 1000px; margin: -32px auto 0; padding: 0 32px">
{% if cover %}
<img src="{{ cover }}" alt="{{ title }}" style="display: block; width: 100%; height: auto; max-height: 480px; object-fit: cover; border-radius: 24px; border: 2px solid #0F1020; box-shadow: 6px 6px 0 #0F1020">
{% else %}
<div role="img" aria-label="封面图占位" style="height: 420px; border-radius: 24px; background: #9BD3FF; border: 2px solid #0F1020; box-shadow: 6px 6px 0 #0F1020; display: flex; align-items: center; justify-content: center; font-size: 15px; color: #0F1020">[封面图]</div>
{% endif %}
</div>

<article style="max-width: 720px; margin: 0 auto; padding: 64px 32px 48px">
<div class="body">
{{ content | safe }}
{% if sources %}
<h2>来源</h2>
<ol>
{% for s in sources %}<li>{{ s }}</li>
{% endfor %}
</ol>
{% endif %}
</div>

<div style="margin-top: 56px; padding: 24px; background: #0F1020; color: #FFFFFF; border-radius: 24px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center">
<div role="img" aria-label="作者照片" style="width: 64px; height: 64px; border-radius: 999px; background: #2A2C44; border: 2px solid #D4FF3A; flex: 0 0 auto"></div>
<div style="flex: 1 1 300px">
<p style="margin: 0; font-weight: 700">吴宜凡 Yifan (Margaret) Wu</p>
<p style="margin: 0; font-size: 15px; color: #D5D7E2">纽约大学体育商业硕士，顺着钱的流向看体育，尤其是女性体育。</p>
</div>
<a href="https://www.linkedin.com/in/yifanwu-43998b2b1" style="padding: 12px 20px; background: #D4FF3A; color: #0F1020; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 15px">LinkedIn</a>
</div>

<p style="margin: 40px 0 0"><a href="/zh/#work" style="font-weight: 700">← 回到作品</a></p>
</article>

</div>
</body>
</html>
