<script>
(function(){
  var btns = document.querySelectorAll('button.f'), arts = document.querySelectorAll('article[data-cats]'), cnt = document.getElementById('count');
  function show(k){
    var n = 0;
    arts.forEach(function(a){ var on = k === 'all' || a.getAttribute('data-cats').split(' ').indexOf(k) !== -1; a.style.display = on ? '' : 'none'; if (on) n++; });
    btns.forEach(function(b){ var on = b.getAttribute('data-k') === k; b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.style.background = on ? '#0F1020' : b.getAttribute('data-bg'); b.style.color = on ? '#D4FF3A' : '#0F1020'; });
    cnt.textContent = '共 ' + n + ' 篇';
  }
  btns.forEach(function(b){ b.addEventListener('click', function(){ show(b.getAttribute('data-k')); }); });
  show('all');
})();
</script>
